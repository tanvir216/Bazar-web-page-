# MongoDB connection string (MongoDB Atlas works well on Vercel)
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/bazardor
# Random 32+ char secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me
# Your site URL (http://localhost:3000 locally, your Vercel URL in production)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: override product API base URL
NEXT_PUBLIC_API_BASE=https://api.api-store.workers.dev/api/bazardor
NEXT_PUBLIC_API_BASE_ALT=https://api.abcz.workers.dev/api/bazardor
